<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
	<file datatype="plaintext" original="messages" source-language="en" target-language="ja">
		<body>
			<trans-unit id="AlertNoExtractedDataToEdit" resname="AlertNoExtractedDataToEdit">
				<source>No extracted data to edit</source>
				<target>編集する抽出データがありません</target>
			</trans-unit>
			<trans-unit id="AlertFileNotFound" resname="AlertFileNotFound">
				<source>File not found: {path}</source>
				<target>ファイルが見つかりません：{path}</target>
			</trans-unit>
			<trans-unit id="AlertFileTooLarge" resname="AlertFileTooLarge">
				<source>File too large. Maximum size is 10MB.</source>
				<target>ファイルが大きすぎます。最大サイズは10MBです。</target>
			</trans-unit>
			<trans-unit id="AlertSaveDocumentFailed" resname="AlertSaveDocumentFailed">
				<source>Failed to save document record</source>
				<target>文書のレコードを保存できませんでした</target>
			</trans-unit>
			<trans-unit id="DocumentType_Unknown" resname="DocumentType_Unknown">
				<source>Unknown</source>
				<target>不明</target>
			</trans-unit>
			<trans-unit id="Context_NoExtractedData" resname="Context_NoExtractedData">
				<source>No extracted data available.</source>
				<target>抽出データがありません。</target>
			</trans-unit>
			<trans-unit id="Chat_Empty" resname="Chat_Empty">
				<source>💬 No messages yet. Start a conversation!</source>
				<target>💬 まだメッセージはありません。会話を始めましょう！</target>
			</trans-unit>
			<trans-unit id="Chat_You" resname="Chat_You">
				<source>👤 You</source>
				<target>👤 あなた</target>
			</trans-unit>
			<trans-unit id="Chat_Assistant" resname="Chat_Assistant">
				<source>🤖 Assistant</source>
				<target>🤖 アシスタント</target>
			</trans-unit>
			<trans-unit id="Chat_Thinking1" resname="Chat_Thinking1">
				<source>💭 Thinking...</source>
				<target>💭 考えています...</target>
			</trans-unit>
			<trans-unit id="Chat_Thinking2" resname="Chat_Thinking2">
				<source>🤔 Processing...</source>
				<target>🤔 処理しています...</target>
			</trans-unit>
			<trans-unit id="Chat_Thinking3" resname="Chat_Thinking3">
				<source>⚡ Analyzing...</source>
				<target>⚡ 解析しています...</target>
			</trans-unit>
			<trans-unit id="Chat_Thinking4" resname="Chat_Thinking4">
				<source>🔍 Examining...</source>
				<target>🔍 確認しています...</target>
			</trans-unit>
			<trans-unit id="Chat_Thinking5" resname="Chat_Thinking5">
				<source>✨ Generating response...</source>
				<target>✨ 回答を生成しています...</target>
			</trans-unit>
			<trans-unit id="Extracted_NoDataAvailable" resname="Extracted_NoDataAvailable">
				<source>No extracted data available</source>
				<target>抽出データがありません</target>
			</trans-unit>
			<trans-unit id="Extracted_NoDataFound" resname="Extracted_NoDataFound">
				<source>⚠️ No extracted data found</source>
				<target>⚠️ 抽出データが見つかりません</target>
			</trans-unit>
			<trans-unit id="Extracted_NoDataFoundError" resname="Extracted_NoDataFoundError">
				<source>❌ No extracted data found</source>
				<target>❌ 抽出データが見つかりません</target>
			</trans-unit>
			<trans-unit id="Extracted_DocumentNotFound" resname="Extracted_DocumentNotFound">
				<source>Document not found</source>
				<target>文書が見つかりません</target>
			</trans-unit>
			<trans-unit id="Extracted_Details" resname="Extracted_Details">
				<source>{type} DETAILS</source>
				<target>{type}の詳細</target>
			</trans-unit>
			<trans-unit id="Extracted_Date" resname="Extracted_Date">
				<source>Extracted: {date}</source>
				<target>抽出日時：{date}</target>
			</trans-unit>
			<trans-unit id="Extracted_Error" resname="Extracted_Error">
				<source>❌ ERROR&#10;&#10;{message}</source>
				<target>❌ エラー&#10;&#10;{message}</target>
			</trans-unit>
			<trans-unit id="Extracted_Processing" resname="Extracted_Processing">
				<source>🔄 Processing document asynchronously...&#10;&#10;Please wait while the AI analyzes your document.</source>
				<target>🔄 文書を非同期で処理しています...&#10;&#10;AIが文書を解析するまでお待ちください。</target>
			</trans-unit>
			<trans-unit id="Extracted_ClickAnalyze" resname="Extracted_ClickAnalyze">
				<source>No extracted data available.&#10;&#10;Please click 'Analyze Selected' to extract data from this document.</source>
				<target>抽出データがありません。&#10;&#10;「選択した文書を解析」をクリックして、この文書からデータを抽出してください。</target>
			</trans-unit>
			<trans-unit id="ConfirmDeleteDocument" resname="ConfirmDeleteDocument">
				<source>Delete document '{name}'? This action cannot be undone.</source>
				<target>文書「{name}」を削除しますか？この操作は取り消せません。</target>
			</trans-unit>
			<trans-unit id="AlertDocumentDeleted" resname="AlertDocumentDeleted">
				<source>Document and all related data deleted successfully</source>
				<target>文書と関連するすべてのデータを削除しました</target>
			</trans-unit>
			<trans-unit id="AlertSelectDocumentToDelete" resname="AlertSelectDocumentToDelete">
				<source>Please select a document to delete</source>
				<target>削除する文書を選択してください</target>
			</trans-unit>
			<trans-unit id="Summary_NoDocumentSelected" resname="Summary_NoDocumentSelected">
				<source>No document selected</source>
				<target>文書が選択されていません</target>
			</trans-unit>
			<trans-unit id="Upload_SelectDocument" resname="Upload_SelectDocument">
				<source>Select a document to upload</source>
				<target>アップロードする文書を選択してください</target>
			</trans-unit>
			<trans-unit id="AlertUploaded" resname="AlertUploaded">
				<source>Document uploaded successfully. Click 'Analyze Selected' to extract data.</source>
				<target>文書をアップロードしました。「選択した文書を解析」をクリックしてデータを抽出してください。</target>
			</trans-unit>
			<trans-unit id="AlertNoExtractedDataAnalyzeFirst" resname="AlertNoExtractedDataAnalyzeFirst">
				<source>No extracted data found for this document.&#10;&#10;Please analyze the document first.</source>
				<target>この文書の抽出データが見つかりません。&#10;&#10;先に文書を解析してください。</target>
			</trans-unit>
			<trans-unit id="AlertSelectDocumentFirst" resname="AlertSelectDocumentFirst">
				<source>Please select a document first.</source>
				<target>先に文書を選択してください。</target>
			</trans-unit>
			<trans-unit id="AlertSelectProcessedDocument" resname="AlertSelectProcessedDocument">
				<source>Please select a processed document first</source>
				<target>先に解析済みの文書を選択してください</target>
			</trans-unit>
			<trans-unit id="ConfirmReanalyze" resname="ConfirmReanalyze">
				<source>This document has already been analyzed. Do you really want to reanalyze?</source>
				<target>この文書はすでに解析されています。もう一度解析しますか？</target>
			</trans-unit>
			<trans-unit id="Summary_Generating" resname="Summary_Generating">
				<source>⏳ Generating {type} summary...</source>
				<target>⏳ {type}の要約を生成しています...</target>
			</trans-unit>
			<trans-unit id="Summary_NotAvailable" resname="Summary_NotAvailable">
				<source>No &lt;strong&gt;{type}&lt;/strong&gt; summary available.</source>
				<target>&lt;strong&gt;{type}&lt;/strong&gt;の要約はまだありません。</target>
			</trans-unit>
			<trans-unit id="Summary_ClickGenerate" resname="Summary_ClickGenerate">
				<source>Click &lt;strong&gt;Generate&lt;/strong&gt; to create one.</source>
				<target>&lt;strong&gt;生成&lt;/strong&gt;をクリックして作成してください。</target>
			</trans-unit>
			<trans-unit id="Summary_NoneAvailable" resname="Summary_NoneAvailable">
				<source>No summary available. Click Generate to create one.</source>
				<target>要約はまだありません。「生成」をクリックして作成してください。</target>
			</trans-unit>
			<trans-unit id="AlertInvalidJSON" resname="AlertInvalidJSON">
				<source>Invalid JSON format!&#10;&#10;Please fix the JSON syntax before saving.</source>
				<target>JSONの形式が正しくありません。&#10;&#10;保存する前にJSONの構文を修正してください。</target>
			</trans-unit>
			<trans-unit id="AlertExtractedDataSaved" resname="AlertExtractedDataSaved">
				<source>✅ Extracted data saved successfully!</source>
				<target>✅ 抽出データを保存しました。</target>
			</trans-unit>
			<trans-unit id="AlertSaveDataError" resname="AlertSaveDataError">
				<source>❌ Error saving data to database.</source>
				<target>❌ データベースへの保存中にエラーが発生しました。</target>
			</trans-unit>
			<trans-unit id="AlertNoExtractedDataEntity" resname="AlertNoExtractedDataEntity">
				<source>❌ No extracted data entity found.</source>
				<target>❌ 抽出データのエンティティが見つかりません。</target>
			</trans-unit>
			<trans-unit id="AlertDocumentNotFound" resname="AlertDocumentNotFound">
				<source>ERROR: Document not found!</source>
				<target>エラー：文書が見つかりません。</target>
			</trans-unit>
			<trans-unit id="AlertNoExtractedDataForDocument" resname="AlertNoExtractedDataForDocument">
				<source>ERROR: No extracted data found for this document! Please analyze the document first.</source>
				<target>エラー：この文書の抽出データが見つかりません。先に文書を解析してください。</target>
			</trans-unit>
			<trans-unit id="AlertContextEmpty" resname="AlertContextEmpty">
				<source>ERROR: Context is empty!</source>
				<target>エラー：コンテキストが空です。</target>
			</trans-unit>
			<trans-unit id="Error_Unknown" resname="Error_Unknown">
				<source>Unknown error</source>
				<target>不明なエラー</target>
			</trans-unit>
			<trans-unit id="Error_InvalidHistory" resname="Error_InvalidHistory">
				<source>Invalid conversation history</source>
				<target>会話履歴が無効です</target>
			</trans-unit>
			<trans-unit id="Error_CreateConversation" resname="Error_CreateConversation">
				<source>Failed to create conversation</source>
				<target>会話を作成できませんでした</target>
			</trans-unit>
		</body>
	</file>
</xliff>
